---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found | Nate Richardson" description="This page could not be found. Return to Nate Richardson’s homepage." canonicalPath="/404" noindex>
  <div class="error-page">
    <div class="error-dialog">
      <div class="error-body">
        <div class="error-content">
          <h1 class="error-heading">Page not found</h1>
          <p class="error-detail">
            This page may have moved or no longer exists.
          </p>
          <p class="error-suggestion">
            Make sure the path is correct and try again.
          </p>
        </div>
      </div>

      <!-- Buttons -->
      <div class="error-actions">
        <a href="/" class="error-btn">Back to home</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    position: fixed;
    inset: 0;
    background: #07030f;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .error-dialog {
    max-width: 420px;
    width: 100%;
    padding: 24px;
  }

  .error-body {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 16px 12px;
  }

  .error-icon {
    font-size: 32px;
    line-height: 1;
    flex-shrink: 0;
  }

  .error-content {
    flex: 1;
  }

  .error-heading {
    font-weight: bold;
    margin: 0 0 8px 0;
    font-size: 28px;
  }

  .error-detail {
    margin: 0 0 8px 0;
    font-size: 16px;
    line-height: 1.5;
    word-break: break-all;
  }

  .error-suggestion {
    margin: 0;
    font-size: 16px;
    color: #bcb2d0;
  }

  .error-actions {
    text-align: center;
    padding: 4px 16px 12px;
  }

  .error-btn {
    display: inline-block;
    min-width: 90px;
    text-align: center;
    text-decoration: none;
    color: #f3f1fa;
    font-family: inherit;
    font-size: 16px;
  }
</style>
