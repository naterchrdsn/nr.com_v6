---
/**
 * Interactive WebGL nebula background.
 *
 * - Domain-warped gas with dark dust lanes + 3 quiet star layers in one shader.
 * - Pointer gently shifts the starfield without distorting the gas.
 * - Click/tap fires a shockwave; press-and-hold creates a star
 *   that stays in the sky and slowly fades.
 * - Typing "nebula" cycles the palette.
 * - Falls back to a CSS gradient without WebGL; shows a still frame when the
 *   user prefers reduced motion; pauses when the tab is hidden; lowers render
 *   resolution automatically if frames get slow.
 */
---

<div class="nebula-bg" aria-hidden="true">
  <canvas id="nebula-canvas"></canvas>
</div>

<style is:global>
  .nebula-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 25% 30%, #3b1572 0%, transparent 55%),
      radial-gradient(ellipse at 75% 65%, #0b5560 0%, transparent 50%),
      #07030f;
  }
  .nebula-bg canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Keep page content above the background. */
  #main-content {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  const VERT = `
    attribute vec2 aPos;
    void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
  `;

  const FRAG = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif

    uniform vec2 uRes;
    uniform float uTime;
    uniform vec2 uMouse;        // smoothed pointer offset, roughly -0.5..0.5 (parallax)
    uniform vec3 uC0;
    uniform vec3 uC1;
    uniform vec3 uC2;

    uniform vec4 uWave[6];      // xy position, z age (s), w active
    uniform vec4 uStar[8];      // xy position, z growth 0..1, w brightness

    float hash(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }
    vec2 hash2(vec2 p) { return vec2(hash(p), hash(p + 19.19)); }

    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      float a = hash(i);
      float b = hash(i + vec2(1.0, 0.0));
      float c = hash(i + vec2(0.0, 1.0));
      float d = hash(i + vec2(1.0, 1.0));
      return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
    }

    const mat2 ROT = mat2(0.8, -0.6, 0.6, 0.8);

    float fbm4(vec2 p) {
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 4; i++) {
        v += a * noise(p);
        p = ROT * p * 2.02;
        a *= 0.5;
      }
      return v;
    }
    float fbm5(vec2 p) {
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 5; i++) {
        v += a * noise(p);
        p = ROT * p * 2.02;
        a *= 0.5;
      }
      return v;
    }

    vec3 starLayer(vec2 p, float scale, float layer, vec2 par) {
      vec2 uv = p * scale + par * layer * 0.25 + vec2(uTime * 0.003 * layer, 0.0);
      vec2 id = floor(uv);
      vec2 f = fract(uv) - 0.5;
      float h = hash(id);
      if (h < 0.80) return vec3(0.0);
      vec2 off = (hash2(id + 7.0) - 0.5) * 0.7;
      float d = length(f - off);
      // Most stars remain steady; only a sparse few gently vary over many seconds.
      float tw = 1.0;
      if (h > 0.985) tw = 0.94 + 0.06 * sin(uTime * (0.18 + h * 0.12) + h * 40.0);
      float size = 0.10 - 0.025 * layer;
      float b = 1.0 - smoothstep(0.0, size, d);
      float luminosity = hash(id + 3.0);
      b *= b * tw * (0.12 + 0.58 * luminosity * luminosity);
      vec3 tint = mix(vec3(1.0, 0.80, 0.60), vec3(0.70, 0.85, 1.0), hash(id + 11.0));
      return tint * b * (0.7 + 0.4 * layer);
    }

    void main() {
      vec2 p = (gl_FragCoord.xy - 0.5 * uRes) / uRes.y;
      vec2 m = uMouse;
      vec2 p0 = p;            // unwarped coordinates for stars
      float glow = 0.0;      // extra light from shockwaves


      // ---- Shockwaves: radial ripple through the gas
      for (int i = 0; i < 6; i++) {
        vec4 w = uWave[i];
        if (w.w > 0.0) {
          vec2 d = p - w.xy;
          float r = length(d) + 1e-4;
          float ring = exp(-pow((r - w.z * 0.65) * 12.0, 2.0)) * exp(-w.z * 1.2);
          p += (d / r) * ring * 0.07;
          glow += ring * 0.35;
        }
      }


      // ---- Gas: domain-warped fbm
      float t = uTime * 0.035;
      vec2 g = p * 1.7;
      vec2 q = vec2(fbm4(g + vec2(0.0, t)), fbm4(g + vec2(5.2, 1.3) - t));
      vec2 r = vec2(fbm4(g + 2.4 * q + vec2(1.7, 9.2) + t * 1.3),
                    fbm4(g + 2.4 * q + vec2(8.3, 2.8) - t));
      float f = fbm5(g + 2.6 * r);

      vec3 bg = vec3(0.018, 0.010, 0.045);
      vec3 col = bg;
      col = mix(col, uC0, smoothstep(0.20, 0.85, f) * 0.85);
      col = mix(col, uC1, clamp(q.x * q.x * 2.6, 0.0, 1.0) * 0.8 * smoothstep(0.2, 0.7, f));
      col = mix(col, uC2, smoothstep(0.40, 0.95, r.y) * 0.75);
      // bright filaments where warp folds over itself
      col += uC1 * pow(clamp(f * r.x * 1.6, 0.0, 1.0), 4.0) * 0.55;

      // Broad dust lanes reuse the existing fields: depth without more noise samples.
      float dustField = f + 0.32 * (q.y - r.x);
      float dust = (1.0 - smoothstep(0.30, 0.48, dustField))
                 * smoothstep(0.20, 0.55, q.x + 0.25 * r.y);
      col = mix(col, bg * 0.7, dust * 0.68);
      col += mix(uC2, vec3(1.0), 0.4) * glow;

      // ---- Quiet starfield, partially obscured by foreground dust.
      vec3 stars = starLayer(p0, 16.0, 1.0, m)
                 + starLayer(p0, 30.0, 2.0, m)
                 + starLayer(p0, 54.0, 3.0, m);
      col += stars * (1.0 - dust * 0.72);

      // ---- Held / released stars
      for (int i = 0; i < 8; i++) {
        vec4 s = uStar[i];
        if (s.w > 0.0) {
          vec2 d = p0 - s.xy;
          float r0 = length(d);
          float rad = 0.012 + 0.05 * s.z;
          float core = exp(-pow(r0 / rad, 2.0));
          float halo = rad * 0.55 / (r0 + 0.035);
          float spike = exp(-abs(d.x) * 220.0) * exp(-abs(d.y) * 7.0)
                      + exp(-abs(d.y) * 220.0) * exp(-abs(d.x) * 7.0);
          col += vec3(1.0, 0.93, 0.82) * (core * 1.5 + halo * 0.45 + spike * rad * 2.2) * s.w;
        }
      }

      // vignette + gentle tone map
      col *= 1.0 - 0.5 * dot(p, p) * 0.55;
      col = 1.0 - exp(-col * 1.35);
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const PALETTES: number[][] = [
    [0.42, 0.12, 0.78, 0.95, 0.22, 0.62, 0.05, 0.72, 0.72], // purple / magenta / teal
    [0.95, 0.55, 0.12, 0.85, 0.12, 0.25, 0.10, 0.25, 0.75], // amber / crimson / blue
    [0.10, 0.75, 0.45, 0.10, 0.55, 0.90, 0.50, 0.25, 0.90], // green / cyan / violet
  ];


  const MAX_WAVE = 6;
  const MAX_STAR = 8;
  const WAVE_LIFE = 3.0;
  const STAR_FADE = 60.0;

  function init() {
    const canvas = document.getElementById('nebula-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const gl = (canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' }) ||
      canvas.getContext('experimental-webgl')) as WebGLRenderingContext | null;
    if (!gl) return; // CSS gradient fallback stays visible

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
        console.warn('Nebula shader error:', gl.getShaderInfoLog(s));
        return null;
      }
      return s;
    };
    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const U = (n: string) => gl.getUniformLocation(prog, n);
    const uRes = U('uRes'), uTime = U('uTime'), uMouse = U('uMouse');
    const uC0 = U('uC0'), uC1 = U('uC1'), uC2 = U('uC2');
    const uWave = U('uWave[0]'), uStar = U('uStar[0]');

    const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    let reduced = reduceMq.matches;

    // ---- state
    let quality = 0.6;
    let cssW = 1, cssH = 1;
    const t0 = performance.now() - Math.random() * 60000; // different cloud every visit
    const now = () => (performance.now() - t0) / 1000;


    const waves: { x: number; y: number; t: number }[] = [];
    const stars: { x: number; y: number; t0: number; held: boolean; release: number; growth: number }[] = [];
    const mouse = { x: 0, y: 0, tx: 0, ty: 0 };
    let heldStar: (typeof stars)[number] | null = null;

    let palIdx = 0;
    const palCur = PALETTES[0].slice();


    const waveArr = new Float32Array(MAX_WAVE * 4);
    const starArr = new Float32Array(MAX_STAR * 4);

    const toP = (cx: number, cy: number) => ({ x: (cx - cssW / 2) / cssH, y: (cssH / 2 - cy) / cssH });

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      cssW = window.innerWidth;
      cssH = window.innerHeight;
      canvas!.width = Math.max(2, Math.round(cssW * dpr * quality));
      canvas!.height = Math.max(2, Math.round(cssH * dpr * quality));
      gl!.viewport(0, 0, canvas!.width, canvas!.height);
    }

    // ---- input
    const interactive = (el: EventTarget | null) =>
      el instanceof Element && !!el.closest('a, button, input, textarea, select, [role="button"]');

    function onMove(e: PointerEvent) {
      if (reduced) return;
      const p = toP(e.clientX, e.clientY);
      mouse.tx = (e.clientX / cssW - 0.5);
      mouse.ty = -(e.clientY / cssH - 0.5);

      if (heldStar) {
        heldStar.x = p.x; heldStar.y = p.y;
      }
    }
    function onDown(e: PointerEvent) {
      if (reduced || e.button > 0 || interactive(e.target)) return;
      const p = toP(e.clientX, e.clientY);
      const tNow = now();
      waves.push({ x: p.x, y: p.y, t: tNow });
      if (waves.length > MAX_WAVE) waves.shift();
      heldStar = { x: p.x, y: p.y, t0: tNow, held: true, release: 0, growth: 0 };
      stars.push(heldStar);
      if (stars.length > MAX_STAR) stars.shift();
    }
    function onUp() {
      if (!heldStar) return;
      const tNow = now();
      if (tNow - heldStar.t0 < 0.25) {
        const i = stars.indexOf(heldStar); // a tap, not a hold: wave only
        if (i >= 0) stars.splice(i, 1);
      } else {
        heldStar.held = false;
        heldStar.release = tNow;
      }
      heldStar = null;
    }
    function onLeave() {
      mouse.tx = 0; mouse.ty = 0;
      onUp();
    }

    // ---- easter egg: type "nebula"
    let typed = '';
    function onKey(e: KeyboardEvent) {
      if (e.target instanceof HTMLElement && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;
      if (e.key.length !== 1) return;
      typed = (typed + e.key.toLowerCase()).slice(-6);
      if (typed === 'nebula') {
        palIdx = (palIdx + 1) % PALETTES.length;
        typed = '';
      }
    }

    // ---- frame
    let raf = 0;
    let last = performance.now();
    let ema = 16;
    let frames = 0;

    function draw(tNow: number) {
      // ease palette & parallax
      const target = PALETTES[palIdx];
      for (let i = 0; i < 9; i++) palCur[i] += (target[i] - palCur[i]) * 0.04;
      mouse.x += (mouse.tx - mouse.x) * 0.05;
      mouse.y += (mouse.ty - mouse.y) * 0.05;


      waveArr.fill(0);
      for (let i = waves.length - 1; i >= 0; i--) if (tNow - waves[i].t > WAVE_LIFE) waves.splice(i, 1);
      waves.forEach((w, i) => waveArr.set([w.x, w.y, tNow - w.t, 1], i * 4));

      starArr.fill(0);
      for (let i = stars.length - 1; i >= 0; i--) {
        const s = stars[i];
        if (!s.held && tNow - s.release > STAR_FADE) stars.splice(i, 1);
      }
      stars.forEach((s, i) => {
        if (s.held) s.growth = Math.min((tNow - s.t0) / 2.5, 1);
        const bright = s.held ? 1 : Math.max(0, 1 - (tNow - s.release) / STAR_FADE);
        starArr.set([s.x, s.y, s.growth, bright], i * 4);
      });

      gl!.uniform2f(uRes, canvas!.width, canvas!.height);
      gl!.uniform1f(uTime, tNow);
      gl!.uniform2f(uMouse, mouse.x, mouse.y);
      gl!.uniform3f(uC0, palCur[0], palCur[1], palCur[2]);
      gl!.uniform3f(uC1, palCur[3], palCur[4], palCur[5]);
      gl!.uniform3f(uC2, palCur[6], palCur[7], palCur[8]);

      gl!.uniform4fv(uWave, waveArr);
      gl!.uniform4fv(uStar, starArr);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
    }

    function frame() {
      const nowMs = performance.now();
      const dt = nowMs - last;
      last = nowMs;
      ema = ema * 0.95 + Math.min(dt, 100) * 0.05;
      if (++frames % 90 === 0) {
        // adapt resolution to keep ~30+ fps
        if (ema > 30 && quality > 0.3) { quality = Math.max(0.3, quality - 0.1); resize(); }
        else if (ema < 14 && quality < 0.8) { quality = Math.min(0.8, quality + 0.05); resize(); }
      }
      draw(now());
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (raf || reduced) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      cancelAnimationFrame(raf);
      raf = 0;
    }

    function applyMotionPref() {
      reduced = reduceMq.matches;
      if (reduced) {
        stop();
        mouse.x = mouse.y = mouse.tx = mouse.ty = 0;
        waves.length = 0;
        stars.length = 0;
        heldStar = null;
        draw(12.0); // single still frame
      } else {
        start();
      }
    }

    // ---- wire up
    resize();
    window.addEventListener('resize', () => { resize(); if (reduced) draw(12.0); });
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerdown', onDown, { passive: true });
    window.addEventListener('pointerup', onUp, { passive: true });
    window.addEventListener('pointercancel', onUp, { passive: true });
    document.documentElement.addEventListener('pointerleave', onLeave);
    window.addEventListener('keydown', onKey);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduceMq.addEventListener('change', applyMotionPref);
    canvas.addEventListener('webglcontextlost', (e) => { e.preventDefault(); stop(); });
    canvas.addEventListener('webglcontextrestored', () => location.reload());

    applyMotionPref();
  }

  init();
</script>
