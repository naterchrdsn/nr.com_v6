---
// Selected Constellation design; original exploration remains under public/prototypes.
---
<canvas id="sky" aria-hidden="true"></canvas><div class="shade"></div><section class="constellation" aria-labelledby="home-title"><header class="identity"><div class="overline">naterichardson.com</div><h1 id="home-title">Nate <span>Richardson.</span></h1><p class="intro">Frontend architect &amp; developer in Atlanta, GA.<br>I build things at <a href="https://nacholabs.net">Nacho Labs</a>.</p><p class="sky-note">A new constellation with every page load.<br>Drag the stars to rearrange it. Click a label to visit.</p></header><nav class="map" aria-label="Star destinations"><a class="destination" href="https://nacholabs.net"><span class="star" aria-hidden="true"></span><span><strong>Nacho Labs</strong><small>Small-business consulting</small></span><span class="arrow" aria-hidden="true">↗</span></a><a class="destination" href="https://nacholabs.net/projects"><span class="star" aria-hidden="true"></span><span><strong>Projects</strong><small>Products &amp; experiments</small></span><span class="arrow" aria-hidden="true">↗</span></a><a class="destination" href="https://github.com/naterchrdsn"><span class="star" aria-hidden="true"></span><span><strong>GitHub</strong><small>Code &amp; open source</small></span><span class="arrow" aria-hidden="true">↗</span></a><a class="destination" href="https://www.linkedin.com/in/naterchrdsn/"><span class="star" aria-hidden="true"></span><span><strong>LinkedIn</strong><small>Work &amp; experience</small></span><span class="arrow" aria-hidden="true">↗</span></a><a class="destination" href="https://bsky.app/profile/naterichardson.com"><span class="star" aria-hidden="true"></span><span><strong>Bluesky</strong><small>@naterichardson.com</small></span><span class="arrow" aria-hidden="true">↗</span></a><a class="destination" href="https://x.com/naterchrdsn"><span class="star" aria-hidden="true"></span><span><strong>X</strong><small>@naterchrdsn</small></span><span class="arrow" aria-hidden="true">↗</span></a></nav><footer class="bottom"><div class="caption">Helping people do what they love, better.</div><div class="controls"><button id="new-sky" type="button">New sky ↗</button><button id="replay" type="button">Replay first light ↗</button><button id="pause" type="button" aria-pressed="false">Pause motion</button></div></footer><span role="status" id="status" class="status"></span></section>
<style is:global>

*{box-sizing:border-box}html{background:#080915;color:#f7f4ed}body{margin:0;font-family:Arial,Helvetica,sans-serif;min-height:100svh}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit}#sky{position:fixed;inset:0;width:100%;height:100%;pointer-events:none}.shade{position:fixed;inset:0;pointer-events:none;background:linear-gradient(115deg,#050815a8,transparent 60%),linear-gradient(0deg,#060915ba,transparent 35%)}.constellation{position:relative;min-height:100svh;padding:34px 5vw 28px;display:flex;flex-direction:column}.review{display:flex;align-items:center;gap:19px;font:10px/1.4 monospace;letter-spacing:.06em;text-transform:uppercase;color:#b7c0d4}.review .concept{margin-left:auto;color:#d7c5ef}.review a{padding:8px 0}.review a:hover{color:white}.identity{position:relative;z-index:2;margin-top:clamp(45px,8vh,90px);max-width:460px;pointer-events:none}.identity a{pointer-events:auto;border-bottom:1px solid #a5a3bf}.overline{color:#c8aedb;font:11px/1.5 monospace;text-transform:uppercase;letter-spacing:.22em}.overline:before{content:'✧';font-size:16px;vertical-align:-1px;margin-right:12px}h1{font-size:clamp(43px,5vw,74px);line-height:1.05;letter-spacing:-.06em;font-weight:400;margin:19px 0 21px}h1 span{display:block}.intro{font-size:15px;line-height:1.8;color:#c3c8da;margin:0}.map{position:absolute;inset:0;pointer-events:none}.destination{position:absolute;display:flex;align-items:center;gap:17px;padding:15px 18px 15px 0;pointer-events:auto;min-height:68px;transform:translate(-11px,-34px)}.destination .star{position:relative;width:21px;height:21px;flex-shrink:0;display:grid;place-items:center}.star:before{content:'';width:5px;height:5px;background:#edf5ff;border-radius:50%;box-shadow:0 0 8px 2px #acccff,0 0 35px 6px #608cff77;transition:box-shadow .25s,transform .25s}.star:after{content:'';position:absolute;inset:-5px;border:1px solid #becff955;border-radius:50%;transition:border-color .25s,transform .25s}.destination strong{font-size:17px;font-weight:400;letter-spacing:-.02em;display:block}.destination small{display:block;font:9px/1.6 monospace;letter-spacing:.13em;text-transform:uppercase;color:#a6b5cf;margin-top:4px}.destination .arrow{font-size:14px;color:#9eadd0;opacity:0;transform:translate(-5px,4px);transition:opacity .2s,transform .2s}.destination:hover .arrow,.destination:focus-visible .arrow{opacity:1;transform:none}.destination:hover .star:before,.destination:focus-visible .star:before{transform:scale(1.6);box-shadow:0 0 12px 4px #f0d5ff,0 0 55px 12px #cb8eff88}.destination:hover .star:after,.destination:focus-visible .star:after{transform:scale(1.25);border-color:#e8d4ff}.destination:nth-child(1){left:56%;top:35%}.destination:nth-child(2){left:75%;top:51%}.destination:nth-child(3){left:60%;top:72%}.destination:nth-child(4){left:37%;top:64%}.destination:nth-child(5){left:26%;top:83%}.bottom{display:flex;align-items:flex-end;justify-content:space-between;gap:25px;margin-top:auto;padding-top:340px;pointer-events:none}.caption{font:10px/1.8 monospace;letter-spacing:.04em;color:#a5adc6}.caption b{display:block;font-weight:400;color:#e0d9ed;letter-spacing:.12em;text-transform:uppercase;margin-bottom:5px}.controls{display:flex;gap:10px;pointer-events:auto}.controls button{border:1px solid #a09cb85e;border-radius:99px;padding:12px 17px;background:#080c191a;cursor:pointer;font:11px monospace;backdrop-filter:blur(8px)}.controls button:hover{border-color:#ded2f0;background:#ac95db15}a:focus-visible,button:focus-visible{outline:2px solid #ddc5ff;outline-offset:7px}.status{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
@media(max-width:700px){.constellation{padding:20px 24px 25px;min-height:1010px}.review{gap:14px;flex-wrap:wrap;font-size:9px}.review .concept{order:-1;width:100%;margin:0 0 4px}.identity{margin-top:38px}h1{font-size:49px;margin:16px 0 18px}h1 span{display:inline}.intro{font-size:14px;line-height:1.75}.map{position:relative;inset:auto;height:480px;margin-top:36px}.destination{transform:none;padding:8px 16px 8px 0;gap:22px;min-height:74px}.destination:nth-child(1){left:24%;top:0}.destination:nth-child(2){left:45%;top:23%}.destination:nth-child(3){left:20%;top:45%}.destination:nth-child(4){left:38%;top:67%}.destination:nth-child(5){left:14%;top:88%}.destination strong{font-size:16px}.destination small{font-size:8px}.destination .arrow{opacity:1}.bottom{padding-top:65px;align-items:flex-start;flex-direction:column;gap:22px}.caption{font-size:10px}.controls{width:100%;justify-content:space-between}.controls button{font-size:10px;padding:12px 16px}}@media(max-height:680px) and (min-width:701px){.constellation{min-height:620px}.identity{margin-top:30px}h1{font-size:54px}.bottom{padding-top:240px}.destination:nth-child(5){top:80%}.caption{max-width:190px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{transition:none!important}}

body { line-height: normal; background: #080915; }
#main-content { min-height: 100svh; }
.sky-note { max-width: 38ch; margin: 22px 0 0; color: #a5adc6; font: 11px/1.8 monospace; }
.star-handle { position: absolute; z-index: 3; width: 34px; height: 34px; padding: 0; border: 1px solid transparent; border-radius: 50%; background: transparent; color: inherit; pointer-events: auto; touch-action: none; cursor: grab; }
.star-handle:hover, .star-handle:focus-visible { border-color: #dfcaff; box-shadow: 0 0 20px #cb8eff55; }
.star-handle.dragging { cursor: grabbing; border-color: #dfcaff; box-shadow: 0 0 30px #cb8eff88; }
.constellation { min-height: max(100svh, 740px); }
.controls { flex-wrap: wrap; }
.destination small { letter-spacing: 0.06em; }
@media (max-width: 1099px) {
  .constellation { min-height: 100svh; }
  .map { position: relative; inset: auto; height: 630px; flex-shrink: 0; margin-top: 32px; }
  .bottom { padding-top: 32px; flex-direction: column; align-items: flex-start; }
  .identity { margin-top: 32px; }
  .destination { min-height: 74px; }
  .controls { width: 100%; justify-content: flex-start; }
}

</style>
<script is:inline>

(()=>{'use strict';const canvas=document.querySelector('#sky'),ctx=canvas.getContext('2d'),links=[...document.querySelectorAll('.destination')],pause=document.querySelector('#pause'),reduce=matchMedia('(prefers-reduced-motion: reduce)');let w=0,h=0,dpr=1,cloud,dark,stars=[],points=[],time=0,birth=reduce.matches?7:0,paused=reduce.matches,raf=0,last=0,active=-1,seed=51874;function random(){seed=(seed*1664525+1013904223)>>>0;return seed/4294967296}function bloom(c,x,y,r,rgb,a){const g=c.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,`rgba(${rgb},${a})`);g.addColorStop(.4,`rgba(${rgb},${a*.45})`);g.addColorStop(1,`rgba(${rgb},0)`);c.fillStyle=g;c.fillRect(x-r,y-r,r*2,r*2)}
function bake(){seed=51874;cloud=document.createElement('canvas');cloud.width=1200;cloud.height=900;const c=cloud.getContext('2d');c.fillStyle='#080b1d';c.fillRect(0,0,1200,900);c.globalCompositeOperation='screen';bloom(c,750,430,530,'67,40,115',.7);bloom(c,870,370,340,'122,38,115',.4);bloom(c,520,590,370,'28,98,131',.5);for(let i=0;i<1400;i++){const t=random(),x=160+t*1120,y=650-t*370+Math.sin(t*8)*115+(random()-.5)*250;const colors=['66,83,173','155,57,126','39,122,155','154,91,164'];bloom(c,x,y,10+random()*100,colors[Math.floor(t*4)%4],.02+random()*.047)}c.globalCompositeOperation='source-over';for(let i=0;i<440;i++){const t=random(),x=160+t*1120,y=650-t*370+Math.sin(t*8)*100+(random()-.5)*95;bloom(c,x,y,8+random()*58,'3,6,16',.09+random()*.12)}c.globalCompositeOperation='screen';for(let i=0;i<1000;i++){const t=random(),x=180+t*1050,y=620-t*320+Math.sin(t*8)*110+(random()-.5)*170;bloom(c,x,y,1+random()*7,random()>.5?'166,180,244':'225,145,199',.025+random()*.13)}dark=document.createElement('canvas');dark.width=1200;dark.height=900;const d=dark.getContext('2d');d.fillStyle='#060918';d.fillRect(0,0,1200,900);d.globalAlpha=.24;d.drawImage(cloud,0,0);stars=Array.from({length:450},()=>({x:random(),y:random(),r:.25+random()*1.05,a:.1+random()*.65,p:random()*6.28}));}
function positions(){points=links.map(a=>{const b=a.querySelector('.star').getBoundingClientRect();return{x:b.left+b.width/2,y:b.top+b.height/2}})}function resize(){w=innerWidth;h=innerHeight;dpr=Math.min(devicePixelRatio||1,1.6);canvas.width=w*dpr;canvas.height=h*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);if(!cloud)bake();positions();draw()}
function draw(){const p=Math.min(1,birth/5),e=1-Math.pow(1-p,3),s=Math.max(w/1200,h/900),cw=1200*s,ch=900*s,x=(w-cw)/2,y=(h-ch)/2;ctx.globalCompositeOperation='source-over';ctx.globalAlpha=1;ctx.drawImage(dark,x,y,cw,ch);ctx.globalAlpha=e;ctx.drawImage(cloud,x+Math.sin(time*.03)*4,y,cw,ch);ctx.globalAlpha=1;ctx.globalCompositeOperation='screen';for(const a of stars){ctx.fillStyle=`rgba(214,225,255,${a.a*(.5+e*.5)*(.9+Math.sin(time*.4+a.p)*.1)})`;ctx.beginPath();ctx.arc(a.x*w,a.y*h,a.r,0,Math.PI*2);ctx.fill()}const origin=points[0]||{x:w*.56,y:h*.35};const l=.3+e*.7;bloom(ctx,origin.x,origin.y,160+e*140,'136,113,235',l*.2);bloom(ctx,origin.x,origin.y,60,'236,199,242',l*.3);bloom(ctx,origin.x,origin.y,13,'245,232,255',l*.8);ctx.globalAlpha=e;for(let i=0;i<points.length-1;i++){const a=points[i],b=points[i+1],highlight=active===i||active===i+1;ctx.strokeStyle=highlight?'rgba(224,208,255,.85)':'rgba(178,191,225,.28)';ctx.lineWidth=highlight?1.4:.65;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();if(highlight){const t=paused?.5:(time*.16)%1;bloom(ctx,a.x+(b.x-a.x)*t,a.y+(b.y-a.y)*t,25,'179,159,255',.33)}}for(let i=0;i<points.length;i++){const a=points[i];bloom(ctx,a.x,a.y,active===i?70:30,active===i?'230,174,250':'117,161,242',active===i?.33:.18)}ctx.globalAlpha=1;if(birth<5&&!reduce.matches){const wave=Math.min(1,birth/4);ctx.strokeStyle=`rgba(215,189,249,${Math.sin(wave*Math.PI)*.1})`;ctx.lineWidth=2;ctx.beginPath();ctx.arc(origin.x,origin.y,wave*Math.max(w,h)*.7,0,Math.PI*2);ctx.stroke()}ctx.globalCompositeOperation='source-over'}
function frame(ts){raf=0;if(paused||document.hidden)return;const dt=last?Math.min(.05,(ts-last)/1000):.016;last=ts;time+=dt;birth+=dt;draw();raf=requestAnimationFrame(frame)}function start(){if(!raf&&!paused&&!document.hidden){last=0;raf=requestAnimationFrame(frame)}}function sync(){pause.textContent=paused?'Resume motion':'Pause motion';pause.setAttribute('aria-pressed',String(paused));if(paused){cancelAnimationFrame(raf);raf=0;birth=Math.max(5,birth);draw()}else start()}pause.addEventListener('click',()=>{paused=!paused;sync()});document.querySelector('#replay').addEventListener('click',()=>{if(paused||reduce.matches){birth=7;active=0;draw();document.querySelector('#status').textContent='First light: the constellation is illuminated.'}else{birth=0;start();document.querySelector('#status').textContent='Replaying first light.'}});links.forEach((a,i)=>{function on(){active=i;draw()}function off(){active=-1;draw()}a.addEventListener('mouseenter',on);a.addEventListener('mouseleave',off);a.addEventListener('focus',on);a.addEventListener('blur',off)});document.addEventListener('visibilitychange',()=>{if(document.hidden){cancelAnimationFrame(raf);raf=0}else start()});reduce.addEventListener('change',()=>{paused=reduce.matches;if(paused)birth=7;sync()});addEventListener('resize',resize);addEventListener('scroll',()=>{positions();if(paused)draw()},{passive:true});resize();sync();})();

</script>
