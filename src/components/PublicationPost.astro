---
import { label } from '../data/publication';
import type { PublicationPost } from '../data/publication';
import { dateLabel, bodyHtml } from '../lib/publication';
interface Props { post: PublicationPost; detail?: boolean; }
const { post, detail = false } = Astro.props;
const Heading = detail ? 'h1' : 'h2';
---
<article data-post data-format={post.format} class:list={['post', { 'post-detail': detail }]}>
  <header>
    <p class="post-meta"><a href={`/posts/${post.slug}/`} aria-label={`Permalink: ${post.title}`}><time datetime={post.publishedAt}>{dateLabel(post.publishedAt)}</time></a><span aria-hidden="true"> · </span><a href={`/posts/format/${post.format}/`}>{label(post.format)}</a></p>
    <Heading class="post-title">{detail ? post.title : <a href={`/posts/${post.slug}/`}>{post.title}</a>}</Heading>
  </header>
  {detail || post.format !== 'article' ? <div class="prose" set:html={bodyHtml(post)} /> : <><p class="post-excerpt">{post.description}</p><a class="continue" href={`/posts/${post.slug}/`}>Read article <span aria-hidden="true">→</span><span class="sr-only">: {post.title}</span></a></>}
  {post.sourceUrl && <p class="post-source">{post.format === 'quote' ? 'Quoted from' : 'Source'}: <a href={post.sourceUrl}>{post.sourceName}</a> <span aria-hidden="true">↗</span></p>}
  <ul class="post-topics" aria-label="Topics">{post.categories.map(category => <li><a href={`/posts/category/${category}/`}>{label(category)}</a></li>)}</ul>
</article>
