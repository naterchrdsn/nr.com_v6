# Revalidate only this site's documents, not sibling applications.
# Hashed Astro assets retain the provider's normal asset caching.
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, max-age=0, must-revalidate" "expr=%{REQUEST_URI} =~ m#^/(?:$|index\.html$|404\.html$|posts(?:/|$)|rss\.xml$|sitemap[^/]*\.xml$|llms\.txt$|robots\.txt$|index\.md$)#"
</IfModule>
